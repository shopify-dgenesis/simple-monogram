# Populated automatically by `shopify app dev` / `shopify app deploy`.
# Set manually only for production deploys outside the Shopify CLI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_products,read_orders,read_themes
SHOPIFY_APP_URL=

DATABASE_URL=
SESSION_SECRET=

# Optional preview/object storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
